 extern bool sec_acl (PACL acl, bool original, bool admins, PSID sid1 = NO_SID,
diff --git a/winsup/cygwin/mm/shared.cc b/winsup/cygwin/mm/shared.cc
--- a/winsup/cygwin/mm/shared.cc
+++ b/winsup/cygwin/mm/shared.cc
@@ -236,5 +236,25 @@

-  user_shared = (user_info *) open_shared (name, USER_VERSION,
-					   cygwin_user_h, sizeof (user_info),
-					   SH_USER_SHARED, &sec_none);
+  // Stock MSYS uses one mapping name per account. A restricted logon
+  // cannot reopen an existing mapping from an ordinary shell. Give this MSYS
+  // mapping a separate name per restricted logon, with rights only on it.
+  WCHAR restricted_name[64];
+  const WCHAR *mapping_name = name;
+  alignas (SECURITY_ATTRIBUTES) char sa_buf[1024];
+  PSECURITY_ATTRIBUTES sa = &sec_none;
+  if (!cygwin_user_h && IsTokenRestricted (hProcToken))
+    {
+      TOKEN_STATISTICS stats;
+      DWORD length = 0;
+      if (!GetTokenInformation (hProcToken, TokenStatistics, &stats,
+                                sizeof (stats), &length))
+        api_fatal ("couldn't locate restricted logon for user mapping, %E");
+      __small_swprintf (restricted_name, L"umeko-restricted-user-%x-%x",
+                        (unsigned) stats.AuthenticationId.HighPart,
+                        (unsigned) stats.AuthenticationId.LowPart);
+      mapping_name = restricted_name;
+      sa = sec_restricted_object (sa_buf, sa, FILE_MAP_ALL_ACCESS);
+    }
+  user_shared = (user_info *) open_shared (mapping_name, USER_VERSION,
+                                           cygwin_user_h, sizeof (user_info),
+                                           SH_USER_SHARED, sa);
   debug_printf ("opening user shared for '%W' at %p", name, user_shared);
diff --git a/winsup/cygwin/pinfo.cc b/winsup/cygwin/pinfo.cc
--- a/winsup/cygwin/pinfo.cc
+++ b/winsup/cygwin/pinfo.cc
@@ -386,5 +386,9 @@
   PSECURITY_ATTRIBUTES sa_buf = (PSECURITY_ATTRIBUTES) alloca (1024);
-  PSECURITY_ATTRIBUTES sec_attribs = sec_user_nih (sa_buf, cygheap->user.sid(),
-						   well_known_world_sid,
-						   FILE_MAP_READ);
+  PSECURITY_ATTRIBUTES sec_attribs = sec_user_nih (
+    sa_buf, cygheap->user.sid (), well_known_world_sid, FILE_MAP_READ);
+  // The restricted fork parent must reopen its child's process record with
+  // the mapping access requested by CreateFileMappingW.
+  alignas (SECURITY_ATTRIBUTES) char restricted_sa[1024];
+  sec_attribs = sec_restricted_object (restricted_sa, sec_attribs,
+                                       FILE_MAP_ALL_ACCESS);

diff --git a/winsup/cygwin/sec/helper.cc b/winsup/cygwin/sec/helper.cc
--- a/winsup/cygwin/sec/helper.cc
+++ b/winsup/cygwin/sec/helper.cc
@@ -629,2 +629,26 @@

+/* Add the token's own logon SID to an explicitly selected MSYS IPC
+   object. Keep the normal user and system ACEs. */
+PSECURITY_ATTRIBUTES
+sec_restricted_object (PVOID storage, PSECURITY_ATTRIBUTES fallback, DWORD access)
+{
+  if (!IsTokenRestricted (hProcToken))
+    return fallback;
+
+  alignas (TOKEN_GROUPS) BYTE logon_data[sizeof (TOKEN_GROUPS) + SECURITY_MAX_SID_SIZE];
+  DWORD length = 0;
+  if (!GetTokenInformation (hProcToken, TokenLogonSid, logon_data,
+                           sizeof (logon_data), &length))
+    return fallback;
+
+  const TOKEN_GROUPS *logon = reinterpret_cast<const TOKEN_GROUPS *> (logon_data);
+  if (logon->GroupCount != 1
+      || (logon->Groups[0].Attributes & SE_GROUP_LOGON_ID) != SE_GROUP_LOGON_ID
+      || !IsValidSid (logon->Groups[0].Sid))
+    return fallback;
+
+  return __sec_user (storage, cygheap->user.sid (), logon->Groups[0].Sid,
+                     access, fallback->bInheritHandle);
+}

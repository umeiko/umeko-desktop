{
  "kind": "umeko-plugin",
  "apiVersion": 1,
  "id": "desktop-pet",
  "name": "桌面小宠物",
  "version": "1.0.0",
  "icon": "pet",
  "summary": "桌宠陪伴、提醒与待办",
  "description": "官方内置桌宠。后台观察任务并管理本机提醒与待办，默认不显示。支持拖动、点击互动、右键菜单与自定义动画形象。",
  "author": "Umeko",
  "lifecycle": "application",
  "entrypoint": "scripts/plugin.py:create_plugin",
  "settingsPage": "qml/Settings.qml",
  "permissions": [],
  "agent": {
    "document": "AGENT.md",
    "methods": {
      "status": {
        "description": "查看实际显示状态、活动摘要、导入进度、提醒统计、宿主时间和设置",
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "appearances": {
        "description": "列出内置和用户导入的形象 id",
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "show": {
        "description": "显示桌宠并保存偏好",
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "hide": {
        "description": "隐藏桌宠，后台观察服务继续运行",
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "resetPosition": {
        "description": "把桌宠放回屏幕右下角",
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "configure": {
        "description": "局部更新桌宠设置并立即生效，不需要重启 Widget",
        "parameters": {
          "type": "object",
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "reminderNotificationsEnabled": {
              "type": "boolean"
            },
            "alwaysOnTop": {
              "type": "boolean"
            },
            "paused": {
              "type": "boolean"
            },
            "appearance": {
              "type": "string",
              "maxLength": 48
            },
            "size": {
              "type": "integer",
              "minimum": 96,
              "maximum": 320
            },
            "sampleIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 2000
            },
            "minimumStateMs": {
              "type": "integer",
              "minimum": 3000,
              "maximum": 30000
            }
          },
          "additionalProperties": false
        }
      },
      "importAppearance": {
        "description": "导入数据型形象 ZIP、pet.json 或单段 WebP/GIF/PNG；完成后返回新形象 id",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        }
      },
      "selectAppearance": {
        "description": "选择已导入的形象",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 48
            }
          },
          "additionalProperties": false,
          "required": [
            "id"
          ]
        }
      },
      "removeAppearance": {
        "description": "删除用户形象，当前形象先回退到八奈见",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 48
            }
          },
          "additionalProperties": false,
          "required": [
            "id"
          ]
        }
      },
      "listItems": {
        "description": "列出本机待办和一次性提醒，返回宿主当前时间；不需要模型轮询计时",
        "parameters": {
          "type": "object",
          "properties": {"status": {"type": "string", "enum": ["open", "completed", "all"]}},
          "additionalProperties": false
        }
      },
      "getItem": {
        "description": "按 id 查看一条本机事项及宿主当前时间",
        "parameters": {
          "type": "object",
          "properties": {"id": {"type": "string", "maxLength": 36}},
          "required": ["id"], "additionalProperties": false
        }
      },
      "createItem": {
        "description": "新增本机待办；可选 dueAt 设置一次性提醒，时间须包含 Z 或 UTC 偏移",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {"type": "string", "maxLength": 200},
            "notes": {"type": "string", "maxLength": 2000},
            "dueAt": {"type": "string", "maxLength": 64, "description": "带时区的 ISO 8601 时间；普通待办省略此字段"}
          },
          "required": ["title"], "additionalProperties": false
        }
      },
      "updateItem": {
        "description": "修改本机事项；改期使旧提醒失效，clearDueAt=true 清除提醒时间",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "maxLength": 36},
            "title": {"type": "string", "maxLength": 200},
            "notes": {"type": "string", "maxLength": 2000},
            "dueAt": {"type": "string", "maxLength": 64},
            "clearDueAt": {"type": "boolean", "description": "true 清除提醒；不能与非空 dueAt 同时设置"}
          },
          "required": ["id"], "additionalProperties": false
        }
      },
      "completeItem": {
        "description": "完成事项并取消未触发的提醒；已完成时返回原事项",
        "parameters": {
          "type": "object", "properties": {"id": {"type": "string", "maxLength": 36}},
          "required": ["id"], "additionalProperties": false
        }
      },
      "deleteItem": {
        "description": "删除本机事项并使旧提醒失效；不存在的 id 返回错误",
        "parameters": {
          "type": "object", "properties": {"id": {"type": "string", "maxLength": 36}},
          "required": ["id"], "additionalProperties": false
        }
      },
      "interact": {
        "description": "触发点击、悬停或拖动互动；动作仍遵守最短保持时间",
        "parameters": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tap",
                "hover",
                "drag"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}

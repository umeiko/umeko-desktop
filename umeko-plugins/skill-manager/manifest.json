{
  "kind": "umeko-plugin",
  "apiVersion": 1,
  "id": "skill-manager",
  "version": "1.0.0",
  "name": "Skill 管理",
  "description": "按全局和工作区浏览 Skill 文件夹，逐项启停当前会话的 Skill，支持导入和文件操作。",
  "summary": "管理全局和工作区 Skill",
  "author": "Umeko",
  "icon": {
    "path": "assets/skill-package.svg"
  },
  "lifecycle": "session",
  "entrypoint": "scripts/plugin.py:create_plugin",
  "page": "qml/Main.qml",
  "readme": "README.md",
  "config": "config.json",
  "configSchema": "config.schema.json",
  "permissions": [
    "skills.read",
    "skills.manage",
    "session.write"
  ],
  "agent": {
    "document": "AGENT.md",
    "methods": {}
  }
}

{
  "kind": "umeko-plugin",
  "apiVersion": 1,
  "id": "scheduled-tasks",
  "version": "1.0.0",
  "name": "定时任务",
  "summary": "向本会话或已关联全局智能体定时发消息",
  "description": "默认开启；单次或周期触发，最短15秒。全局计时器跨会话共享，每会话最多5个（含全局）。",
  "author": "Umeko",
  "icon": "clock",
  "lifecycle": "application",
  "entrypoint": "scripts/plugin.py:create_plugin",
  "page": "qml/Main.qml",
  "readme": "README.md",
  "permissions": [
    "sessions.manage"
  ],
  "agent": {
    "document": "README.md",
    "methods": {
      "targets": {
        "description": "列出本次会话可触发的主 Agent 和已连接 AgentBus 的全局智能体。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "list": {
        "description": "列出调用会话的主 Agent 定时器和全部全局定时器；含停用项，共用5个名额。时间按系统本地时区显示。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "create": {
        "description": "Create and arm a timer (enabled=true by default). One-shot countdowns start now. Reuses an expired, immediately enabled model-created one-shot in this conversation; never overwrites an armed/running or manually edited timer. Maximum 5 timers. Global-Agent timers are shared across all conversations and count toward every conversation’s 5 slots; the original delivery source and Agent Bus permissions are retained.",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "message": {
              "type": "string",
              "maxLength": 8000
            },
            "target": {
              "type": "string",
              "maxLength": 80
            },
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "string",
                  "enum": [
                    "once",
                    "interval"
                  ]
                },
                "first_date": {
                  "type": "string",
                  "maxLength": 10
                },
                "local_time": {
                  "type": "string",
                  "maxLength": 20
                },
                "zone": {
                  "type": "string",
                  "maxLength": 80
                },
                "interval_value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Decimal interval; converted duration must be at least 15 seconds"
                },
                "interval_unit": {
                  "type": "string",
                  "enum": [
                    "days",
                    "hours",
                    "minutes"
                  ]
                },
                "delay_value": {
                  "type": "number",
                  "description": "One-shot countdown from creation; converted duration must be at least 15 seconds. Do not combine with calendar fields.",
                  "minimum": 0
                },
                "delay_unit": {
                  "type": "string",
                  "enum": [
                    "days",
                    "hours",
                    "minutes"
                  ]
                }
              },
              "required": [
                "frequency"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "message",
            "schedule"
          ],
          "additionalProperties": false
        }
      },
      "enable": {
        "description": "启用本会话或共享全局定时器；周期从本次启用重新计时。已删除全局目标须重新绑定。",
        "parameters": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false
        }
      },
      "disable": {
        "description": "停用本会话或共享全局定时器，停止后续触发；已投递消息不撤回。",
        "parameters": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false
        }
      },
      "delete": {
        "description": "删除本会话或共享全局定时器以释放名额；已投递消息不撤回、运行记录保留。",
        "parameters": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false
        }
      },
      "history": {
        "description": "查看本会话或共享全局定时器的最近20次触发结果；已投递不代表Agent任务已完成。",
        "parameters": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "prompt": "For scheduled wake-up tasks, read this Widget’s own docs: umeko_desktop({\"operation\":\"widgets.docs\",\"arguments\":{\"id\":\"scheduled-tasks\"}}).\nExample: start a one-shot countdown now and wake this chat in 5 minutes:\numeko_desktop({\"operation\":\"widgets.call\",\"arguments\":{\"id\":\"scheduled-tasks\",\"method\":\"create\",\"arguments\":{\"name\":\"Wake up in 5 minutes\",\"message\":\"Resume the current task and report progress.\",\"enabled\":true,\"schedule\":{\"frequency\":\"once\",\"delay_value\":5,\"delay_unit\":\"minutes\"}}}})."
  }
}
